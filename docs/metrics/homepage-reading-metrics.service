[Unit]
Description=Private file-backed article readership metrics
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/GB-Project/yuxiaoba.github.io/.metrics/settings.json

[Service]
Type=simple
DynamicUser=yes
User=homepage-metrics
WorkingDirectory=/home/GB-Project/yuxiaoba.github.io
StateDirectory=homepage-reading-metrics
StateDirectoryMode=0700
UMask=0077
LoadCredential=settings.json:/home/GB-Project/yuxiaoba.github.io/.metrics/settings.json
LoadCredential=fullchain.pem:/home/GB-Project/yuxiaoba.github.io/.metrics/acme/live/reading-metrics-ip/fullchain.pem
LoadCredential=privkey.pem:/home/GB-Project/yuxiaoba.github.io/.metrics/acme/live/reading-metrics-ip/privkey.pem
Environment=READING_METRICS_SETTINGS=/run/credentials/homepage-reading-metrics.service/settings.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/GB-Project/yuxiaoba.github.io/.preview/metrics-venv/bin/gunicorn --no-control-socket --workers 1 --threads 4 --bind 0.0.0.0:443 --certfile /run/credentials/homepage-reading-metrics.service/fullchain.pem --keyfile /run/credentials/homepage-reading-metrics.service/privkey.pem --timeout 15 --keep-alive 2 --limit-request-line 1024 --limit-request-fields 32 --limit-request-field_size 2048 --worker-tmp-dir /tmp scripts.reading_metrics:create_app()
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
