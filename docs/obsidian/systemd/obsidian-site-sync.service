[Unit]
Description=Selective Obsidian export and verified personal-site preview update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/GB-Project/yuxiaoba.github.io
# Use the server's existing SSH configuration; never copy keys into this repository.
Environment=PATH=/root/.nvm/versions/node/v24.12.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 scripts/run_obsidian_sync.py --source-repo /home/Obsidian-sync --branch main --pull
TimeoutStartSec=15min
UMask=0077
